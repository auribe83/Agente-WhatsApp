# ==========================================
# ATIENDE - VARIABLES DE ENTORNO
# ==========================================

# URL base de la aplicación (en local http://localhost:3000, en prod tu dominio con https://)
APP_URL="http://localhost:3000"
PORT=3000

# Base de datos PostgreSQL (en local se usa PGlite automáticamente si no hay Docker o PostgreSQL nativo)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/atiende?sslmode=disable&pgbouncer=true&connection_limit=1"

# Credenciales del primer administrador (se crean automáticamente al iniciar si la BD está vacía)
ADMIN_EMAIL="admin@atiende.local"
ADMIN_PASSWORD="AdminPassword2026*"
ADMIN_NAME="Administrador"

# Clave secreta para JWT / Sesiones de Auth
AUTH_SECRET="atiende_super_secret_jwt_key_at_least_32_chars_long_2026"

# Clave de cifrado AES-256-GCM para tokens de integraciones (exactamente 32 bytes hex = 64 caracteres)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# OpenRouter AI (API compatible con OpenAI)
OPENROUTER_API_KEY=""
DEFAULT_AI_MODEL="anthropic/claude-haiku-5.5"

# WhatsApp con Baileys
WHATSAPP_SESSION_DIR="./data/whatsapp_session"

# Sembrar datos de demostración si la base de datos está vacía (Clínica Dental Riky)
SEED_DEMO="true"

# Integraciones de Google (OAuth Web App)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Slack (opcional por variable o desde el panel de integraciones)
SLACK_WEBHOOK_URL=""

# Stripe (opcional por variable o desde el panel de integraciones)
STRIPE_RESTRICTED_KEY=""

# Clave secreta para firmar webhooks salientes
WEBHOOK_SIGNING_SECRET="atiende_webhook_secret_hmac_key_2026"
